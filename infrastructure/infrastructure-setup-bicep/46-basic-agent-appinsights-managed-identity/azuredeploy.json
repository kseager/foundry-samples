{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "6049377302686322365"
    }
  },
  "parameters": {
    "aiServicesName": {
      "type": "string",
      "defaultValue": "foundy",
      "maxLength": 9,
      "metadata": {
        "description": "The name of the Azure AI Foundry resource."
      }
    },
    "projectName": {
      "type": "string",
      "defaultValue": "project",
      "metadata": {
        "description": "The name of your project"
      }
    },
    "projectDescription": {
      "type": "string",
      "defaultValue": "Project with managed identity Application Insights tracing",
      "metadata": {
        "description": "The description of your project"
      }
    },
    "projectDisplayName": {
      "type": "string",
      "defaultValue": "project_display_name",
      "metadata": {
        "description": "The display name of your project"
      }
    },
    "deploymentTimestamp": {
      "type": "string",
      "defaultValue": "[utcNow('yyyyMMddHHmmss')]"
    },
    "deployApplicationInsights": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Deploy Log Analytics + Application Insights (DisableLocalAuth=true), link them to the project with a ProjectManagedIdentity connection, and grant the project managed identity access. Set false to deploy without tracing resources. Default true."
      }
    },
    "existingApplicationInsightsResourceId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional full ARM resource ID of an existing workspace-based Application Insights component to link instead of creating a new one. Ignored when deployApplicationInsights is false. The component is not modified; the deployer needs permission to assign roles on it."
      }
    },
    "assignProjectMonitoringRoles": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Assign the project managed identity its roles on Application Insights. Set false only to test the connection-only experience; without the roles the project cannot read or write telemetry. Default true."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "eastus2",
      "allowedValues": [
        "australiaeast",
        "canadaeast",
        "eastus",
        "eastus2",
        "francecentral",
        "japaneast",
        "koreacentral",
        "norwayeast",
        "polandcentral",
        "southindia",
        "swedencentral",
        "switzerlandnorth",
        "uaenorth",
        "uksouth",
        "westus",
        "westus2",
        "westus3",
        "westeurope",
        "southeastasia",
        "brazilsouth",
        "germanywestcentral",
        "italynorth",
        "southafricanorth",
        "southcentralus"
      ],
      "metadata": {
        "description": "The Azure region where your AI Foundry resource and project will be created."
      }
    },
    "modelName": {
      "type": "string",
      "defaultValue": "gpt-4.1",
      "metadata": {
        "description": "The name of the OpenAI model you want to deploy"
      }
    },
    "modelFormat": {
      "type": "string",
      "defaultValue": "OpenAI",
      "metadata": {
        "description": "The model format of the model you want to deploy. Example: OpenAI"
      }
    },
    "modelVersion": {
      "type": "string",
      "defaultValue": "2025-04-14",
      "metadata": {
        "description": "The version of the model you want to deploy. Example: 2024-11-20"
      }
    },
    "modelSkuName": {
      "type": "string",
      "defaultValue": "GlobalStandard",
      "metadata": {
        "description": "The SKU name for the model deployment. Example: GlobalStandard"
      }
    },
    "modelCapacity": {
      "type": "int",
      "defaultValue": 40,
      "metadata": {
        "description": "The capacity of the model deployment in TPM."
      }
    }
  },
  "variables": {
    "uniqueSuffix": "[substring(uniqueString(format('{0}-{1}', resourceGroup().id, parameters('deploymentTimestamp'))), 0, 4)]",
    "accountName": "[toLower(format('{0}{1}', parameters('aiServicesName'), variables('uniqueSuffix')))]",
    "appInsightsName": "[toLower(format('{0}appinsights', variables('uniqueSuffix')))]",
    "appInsightsPassedIn": "[not(equals(parameters('existingApplicationInsightsResourceId'), ''))]",
    "appInsightsParts": "[split(parameters('existingApplicationInsightsResourceId'), '/')]",
    "appInsightsSubscriptionId": "[if(variables('appInsightsPassedIn'), variables('appInsightsParts')[2], subscription().subscriptionId)]",
    "appInsightsResourceGroupName": "[if(variables('appInsightsPassedIn'), variables('appInsightsParts')[4], resourceGroup().name)]",
    "targetAppInsightsName": "[if(variables('appInsightsPassedIn'), variables('appInsightsParts')[8], variables('appInsightsName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2025-04-01-preview",
      "name": "[variables('accountName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "S0"
      },
      "kind": "AIServices",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "allowProjectManagement": true,
        "customSubDomainName": "[toLower(variables('accountName'))]",
        "networkAcls": {
          "defaultAction": "Allow",
          "virtualNetworkRules": [],
          "ipRules": []
        },
        "publicNetworkAccess": "Enabled",
        "disableLocalAuth": true
      }
    },
    {
      "type": "Microsoft.CognitiveServices/accounts/projects",
      "apiVersion": "2025-04-01-preview",
      "name": "[format('{0}/{1}', variables('accountName'), parameters('projectName'))]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "description": "[parameters('projectDescription')]",
        "displayName": "[parameters('projectDisplayName')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('accountName'))]"
      ]
    },
    {
      "type": "Microsoft.CognitiveServices/accounts/deployments",
      "apiVersion": "2024-10-01",
      "name": "[format('{0}/{1}', variables('accountName'), parameters('modelName'))]",
      "sku": {
        "capacity": "[parameters('modelCapacity')]",
        "name": "[parameters('modelSkuName')]"
      },
      "properties": {
        "model": {
          "name": "[parameters('modelName')]",
          "format": "[parameters('modelFormat')]",
          "version": "[parameters('modelVersion')]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('accountName'))]"
      ]
    },
    {
      "condition": "[parameters('deployApplicationInsights')]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "[format('app-insights-{0}-deployment', variables('uniqueSuffix'))]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "location": {
            "value": "[parameters('location')]"
          },
          "logAnalyticsName": {
            "value": "[toLower(format('{0}loganalytics', variables('uniqueSuffix')))]"
          },
          "appInsightsName": {
            "value": "[variables('appInsightsName')]"
          },
          "existingApplicationInsightsResourceId": {
            "value": "[parameters('existingApplicationInsightsResourceId')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.48.1.52935",
              "templateHash": "15026638977873754123"
            }
          },
          "parameters": {
            "location": {
              "type": "string",
              "metadata": {
                "description": "Azure region for the tracing resources (new resources only)."
              }
            },
            "logAnalyticsName": {
              "type": "string",
              "metadata": {
                "description": "Name of the Log Analytics workspace to create (ignored when reusing an existing component)."
              }
            },
            "appInsightsName": {
              "type": "string",
              "metadata": {
                "description": "Name of the Application Insights component to create (ignored when reusing an existing component)."
              }
            },
            "existingApplicationInsightsResourceId": {
              "type": "string",
              "defaultValue": "",
              "metadata": {
                "description": "Optional full ARM resource ID of an existing workspace-based Application Insights component."
              }
            }
          },
          "variables": {
            "useExisting": "[not(empty(parameters('existingApplicationInsightsResourceId')))]",
            "existingParts": "[split(parameters('existingApplicationInsightsResourceId'), '/')]",
            "targetSubscriptionId": "[if(variables('useExisting'), variables('existingParts')[2], subscription().subscriptionId)]",
            "targetResourceGroupName": "[if(variables('useExisting'), variables('existingParts')[4], resourceGroup().name)]",
            "targetAppInsightsName": "[if(variables('useExisting'), variables('existingParts')[8], parameters('appInsightsName'))]",
            "appInsightsId": "[if(variables('useExisting'), extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', variables('targetSubscriptionId'), variables('targetResourceGroupName')), 'Microsoft.Insights/components', variables('targetAppInsightsName')), resourceId('Microsoft.Insights/components', parameters('appInsightsName')))]"
          },
          "resources": [
            {
              "condition": "[not(variables('useExisting'))]",
              "type": "Microsoft.OperationalInsights/workspaces",
              "apiVersion": "2023-09-01",
              "name": "[parameters('logAnalyticsName')]",
              "location": "[parameters('location')]",
              "properties": {
                "sku": {
                  "name": "PerGB2018"
                },
                "retentionInDays": 30
              }
            },
            {
              "condition": "[not(variables('useExisting'))]",
              "type": "Microsoft.Insights/components",
              "apiVersion": "2020-02-02",
              "name": "[parameters('appInsightsName')]",
              "location": "[parameters('location')]",
              "kind": "web",
              "properties": {
                "Application_Type": "web",
                "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsName'))]",
                "DisableLocalAuth": true,
                "publicNetworkAccessForIngestion": "Enabled",
                "publicNetworkAccessForQuery": "Enabled"
              },
              "dependsOn": [
                "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsName'))]"
              ]
            }
          ],
          "outputs": {
            "appInsightsName": {
              "type": "string",
              "metadata": {
                "description": "Name of the Application Insights component."
              },
              "value": "[variables('targetAppInsightsName')]"
            },
            "appInsightsSubscriptionId": {
              "type": "string",
              "metadata": {
                "description": "Subscription ID that contains the Application Insights component."
              },
              "value": "[variables('targetSubscriptionId')]"
            },
            "appInsightsResourceGroupName": {
              "type": "string",
              "metadata": {
                "description": "Resource group that contains the Application Insights component."
              },
              "value": "[variables('targetResourceGroupName')]"
            },
            "appInsightsId": {
              "type": "string",
              "metadata": {
                "description": "Resource ID of the Application Insights component."
              },
              "value": "[variables('appInsightsId')]"
            },
            "appInsightsAppId": {
              "type": "string",
              "metadata": {
                "description": "Application ID of the Application Insights component (for trace queries)."
              },
              "value": "[if(variables('useExisting'), reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', variables('targetSubscriptionId'), variables('targetResourceGroupName')), 'Microsoft.Insights/components', variables('targetAppInsightsName')), '2020-02-02').AppId, reference(resourceId('Microsoft.Insights/components', parameters('appInsightsName')), '2020-02-02').AppId)]"
            },
            "appInsightsConnectionString": {
              "type": "string",
              "metadata": {
                "description": "Connection string of the Application Insights component."
              },
              "value": "[if(variables('useExisting'), reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', variables('targetSubscriptionId'), variables('targetResourceGroupName')), 'Microsoft.Insights/components', variables('targetAppInsightsName')), '2020-02-02').ConnectionString, reference(resourceId('Microsoft.Insights/components', parameters('appInsightsName')), '2020-02-02').ConnectionString)]"
            }
          }
        }
      }
    },
    {
      "condition": "[parameters('deployApplicationInsights')]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "[format('app-insights-connection-{0}-deployment', variables('uniqueSuffix'))]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "aiAccountName": {
            "value": "[variables('accountName')]"
          },
          "projectName": {
            "value": "[parameters('projectName')]"
          },
          "appInsightsId": {
            "value": "[reference(resourceId('Microsoft.Resources/deployments', format('app-insights-{0}-deployment', variables('uniqueSuffix'))), '2025-04-01').outputs.appInsightsId.value]"
          },
          "appInsightsConnectionString": {
            "value": "[reference(resourceId('Microsoft.Resources/deployments', format('app-insights-{0}-deployment', variables('uniqueSuffix'))), '2025-04-01').outputs.appInsightsConnectionString.value]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.48.1.52935",
              "templateHash": "11479567252628223370"
            }
          },
          "parameters": {
            "aiAccountName": {
              "type": "string",
              "metadata": {
                "description": "Name of the Foundry (AI Services) account that owns the project."
              }
            },
            "projectName": {
              "type": "string",
              "metadata": {
                "description": "Name of the Foundry project to connect Application Insights to."
              }
            },
            "appInsightsId": {
              "type": "string",
              "metadata": {
                "description": "Resource ID of the Application Insights component."
              }
            },
            "appInsightsConnectionString": {
              "type": "string",
              "metadata": {
                "description": "Connection string of the Application Insights component (not a secret on its own with local auth disabled)."
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.CognitiveServices/accounts/projects/connections",
              "apiVersion": "2025-04-01-preview",
              "name": "[format('{0}/{1}/{2}', parameters('aiAccountName'), parameters('projectName'), format('{0}-appinsights', parameters('projectName')))]",
              "properties": {
                "category": "AppInsights",
                "target": "[parameters('appInsightsId')]",
                "authType": "ProjectManagedIdentity",
                "metadata": {
                  "ApiType": "Azure",
                  "ResourceId": "[parameters('appInsightsId')]",
                  "ApplicationInsightsConnectionString": "[parameters('appInsightsConnectionString')]"
                }
              }
            }
          ],
          "outputs": {
            "connectionName": {
              "type": "string",
              "value": "[format('{0}-appinsights', parameters('projectName'))]"
            }
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('accountName'))]",
        "[resourceId('Microsoft.Resources/deployments', format('app-insights-{0}-deployment', variables('uniqueSuffix')))]",
        "[resourceId('Microsoft.CognitiveServices/accounts/projects', variables('accountName'), parameters('projectName'))]"
      ]
    },
    {
      "condition": "[and(parameters('deployApplicationInsights'), parameters('assignProjectMonitoringRoles'))]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "[format('app-insights-ra-{0}-deployment', variables('uniqueSuffix'))]",
      "subscriptionId": "[variables('appInsightsSubscriptionId')]",
      "resourceGroup": "[variables('appInsightsResourceGroupName')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "appInsightsName": {
            "value": "[variables('targetAppInsightsName')]"
          },
          "projectPrincipalId": {
            "value": "[reference(resourceId('Microsoft.CognitiveServices/accounts/projects', variables('accountName'), parameters('projectName')), '2025-04-01-preview', 'full').identity.principalId]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.48.1.52935",
              "templateHash": "7782165536338341458"
            }
          },
          "parameters": {
            "appInsightsName": {
              "type": "string",
              "metadata": {
                "description": "Name of the Application Insights component to grant access on."
              }
            },
            "projectPrincipalId": {
              "type": "string",
              "metadata": {
                "description": "Principal (object) ID of the project managed identity."
              }
            },
            "roleDefinitionGuids": {
              "type": "array",
              "defaultValue": [
                "73c42c96-874c-492b-b04d-ab87d138a893",
                "dbc9c667-e97f-4491-aee6-90b9cf960190",
                "3913510d-42f4-4e42-8a64-420c390055eb"
              ],
              "metadata": {
                "description": "Built-in role definition GUIDs to assign to the project managed identity."
              }
            }
          },
          "resources": [
            {
              "copy": {
                "name": "appInsightsRoleAssignments",
                "count": "[length(parameters('roleDefinitionGuids'))]"
              },
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[resourceId('Microsoft.Insights/components', parameters('appInsightsName'))]",
              "name": "[guid(parameters('projectPrincipalId'), parameters('roleDefinitionGuids')[copyIndex()], resourceId('Microsoft.Insights/components', parameters('appInsightsName')))]",
              "properties": {
                "principalId": "[parameters('projectPrincipalId')]",
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', parameters('roleDefinitionGuids')[copyIndex()])]",
                "principalType": "ServicePrincipal"
              }
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Resources/deployments', format('app-insights-{0}-deployment', variables('uniqueSuffix')))]",
        "[resourceId('Microsoft.CognitiveServices/accounts/projects', variables('accountName'), parameters('projectName'))]"
      ]
    }
  ],
  "outputs": {
    "accountName": {
      "type": "string",
      "value": "[variables('accountName')]"
    },
    "projectName": {
      "type": "string",
      "value": "[parameters('projectName')]"
    },
    "accountEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.CognitiveServices/accounts', variables('accountName')), '2025-04-01-preview').endpoint]"
    },
    "projectEndpoint": {
      "type": "string",
      "value": "[format('https://{0}.services.ai.azure.com/api/projects/{1}', variables('accountName'), parameters('projectName'))]"
    },
    "projectPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.CognitiveServices/accounts/projects', variables('accountName'), parameters('projectName')), '2025-04-01-preview', 'full').identity.principalId]"
    },
    "applicationInsightsResourceId": {
      "type": "string",
      "value": "[if(parameters('deployApplicationInsights'), reference(resourceId('Microsoft.Resources/deployments', format('app-insights-{0}-deployment', variables('uniqueSuffix'))), '2025-04-01').outputs.appInsightsId.value, '')]"
    },
    "applicationInsightsAppId": {
      "type": "string",
      "value": "[if(parameters('deployApplicationInsights'), reference(resourceId('Microsoft.Resources/deployments', format('app-insights-{0}-deployment', variables('uniqueSuffix'))), '2025-04-01').outputs.appInsightsAppId.value, '')]"
    }
  }
}